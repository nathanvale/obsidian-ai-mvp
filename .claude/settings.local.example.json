{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test)",
      "Bash(npx vitest run:*)",
      "Read(./**)"
    ],
    "deny": ["Write(/Users/*/Library/**)"],
    "ask": [
      "Write(package.json)",
      "Write(tsconfig.json)",
      "Write(bun.lockb)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(node:*)",
      "Bash(bun:*)",
      "Bash(npm install:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)"
    ]
  }
}
