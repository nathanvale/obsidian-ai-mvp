{
  "name": "obsidian-ai-mvp",
  "version": "0.1.0",
  "description": "Local-first AI-powered Obsidian knowledge assistant",
  "main": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "bun --watch --hot src/server.ts",
    "dev:debug": "bun --watch --inspect src/server.ts",
    "dev:verbose": "bun --watch --verbose src/server.ts",
    "build": "bun build src/server.ts --outdir=dist --target=bun",
    "build:prod": "bun build src/server.ts --outdir=dist --target=bun --minify --sourcemap",
    "build:analyze": "bun build src/server.ts --outdir=dist --target=bun --analyze",
    "start": "bun dist/server.js",
    "start:prod": "NODE_ENV=production bun dist/server.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:compatibility": "bun run check-node && bun run typecheck && bun run test",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:check": "eslint . --cache --max-warnings 0",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test:smoke": "bun test tests/integration/husky.test.ts",
    "check:no-test": "bun run format:check && bun run lint:check && bun run typecheck",
    "check": "bun run check:no-test && bun run test:smoke",
    "check-node": "node --version && echo 'Node.js version check passed'",
    "check-bun": "bun --version && echo 'Bun version check passed'",
    "health": "bun run health:ollama && bun run health:chromadb",
    "health:ollama": "curl -f http://localhost:11434/api/tags || echo 'Ollama not running'",
    "health:chromadb": "curl -f http://localhost:8000/api/v1/heartbeat || echo 'ChromaDB not running'",
    "services:status": "bun run health",
    "clean": "rm -rf dist node_modules/.cache",
    "reset": "bun run clean && pnpm install",
    "install:clean": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "deps:update": "pnpm update --latest",
    "deps:audit": "pnpm audit"
  },
  "engines": {
    "node": ">=22.11.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@fastify/compress": "7.0.3",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/under-pressure": "8.5.0",
    "@orchestr8/logger": "^1.0.0",
    "@orchestr8/resilience": "^1.0.0",
    "@orchestr8/schema": "^1.0.0",
    "chromadb": "^1.7.3",
    "cohere-ai": "^7.18.1",
    "fastify": "^4.24.3",
    "fastify-plugin": "^5.0.1",
    "ollama": "^0.5.17",
    "pino": "^9.0.0",
    "pino-pretty": "^10.2.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "husky": "^8.0.3",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix --cache",
      "bash -c 'bun run typecheck'"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
